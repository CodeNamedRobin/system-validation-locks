% OTHER IDEA FOR SORT WITH THE SAME ELEMENTS IN THE STRUCT
sort WaterLevel 	= struct top | between | bottom;
	 LightColor 	= struct red | green;
	 GateStatus 	= struct opened | opening | closed | closing | stopped;
	 BoatLocation 	= struct waiting | entering | inLock | exiting | none;
	 BoatPresent 	= struct downBoat | upBoat | empty;
	 LockNr 		= struct l1 | l2;
	 Emergency		= Bool;

% Non-communicating actions
act emergency, emergencyOver: LockNr;

	% Lock actions
	light_TO, light_TI, light_BO, light_BI											: LockNr # LightColor;		% Light actions
	topGate, bottomGate, culvert, paddle 											: LockNr # GateStatus;		% Top gate actions
	detectWater																		: LockNr # WaterLevel;


% Communicating actions
	sendAvailable, receiveAvailable, assignLock										: LockNr # BoatPresent;

% Boat actions
	sendDownBoat, receiveDownBoat, downBoat											: LockNr # BoatLocation;
	sendUpBoat, receiveUpBoat, upBoat												: LockNr # BoatLocation;
	arriveTop, arriveBottom;




proc Lock(	i				:LockNr,
			w_level			:WaterLevel, 
			top_g_status	:GateStatus, 
			bottom_g_status	:GateStatus, 
			top_o_light		:LightColor, 
			top_i_light		:LightColor, 
			bottom_o_light	:LightColor, 
			bottom_i_light	:LightColor,  
			paddle_status	:GateStatus, 
			culvert_status	:GateStatus, 
			boat_present	:BoatPresent, 
			boat_location	:BoatLocation,
			emergency		:Emergency
		) = 
		
		(emergency == false) -> (
			% If any of the gates is moving (opening/closing), they should be stopped
			(top_g_status == opening || top_g_status == closing) -> ( 
				emergency(i).topGate(i,stopped).light_TO(i,red).light_TO(i,red).light_BO(i,red).light_BI(i,red).
							Lock(	top_g_status = stopped, 
									top_o_light = red,
									top_i_light = red,
									bottom_o_light = red,
									bottom_i_light = red,
									emergency = true
								)
			)
			+ (bottom_g_status == opening || bottom_g_status == closing) -> (
				emergency(i).bottomGate(i,stopped).light_TO(i,red).light_TO(i,red).light_BO(i,red).light_BI(i,red).
							Lock(	bottom_g_status = stopped, 
									top_o_light = red,
									top_i_light = red,
									bottom_o_light = red,
									bottom_i_light = red,
									emergency = true
								)
			) 
				% If the paddle is opening or opened, it should close
			+	(paddle_status == opening || paddle_status == opened) ->  
					emergency(i).paddle(i,closing).light_TO(i,red).light_TO(i,red).light_BO(i,red).light_BI(i,red).
								Lock(	top_o_light = red,
										top_i_light = red,
										bottom_o_light = red,
										bottom_i_light = red,
										paddle_status = closing,
										emergency = true
							)
				% If the culvert is opening or opened, it should close
			+ 	(culvert_status == opening || culvert_status == opened) ->
					emergency(i).culvert(i,closing).light_TO(i,red).light_TO(i,red).light_BO(i,red).light_BI(i,red).
								Lock(	top_o_light = red,
										top_i_light = red,
										bottom_o_light = red,
										bottom_i_light = red,
										culvert_status = closing,
										emergency = true
					)
				% If the paddle or culvert are closing or closed, they should be(come) closed
			+ 	((paddle_status == closing || paddle_status == closed || culvert_status == closing || culvert_status == closed) 
					&& (paddle_status != opening && paddle_status != opened && culvert_status != opening && culvert_status != opened
					&& top_g_status != opening && top_g_status != closing && bottom_g_status != opening && bottom_g_status != closing)) ->
					emergency(i).light_TO(i,red).light_TO(i,red).light_BO(i,red).light_BI(i,red).
								Lock(	top_o_light = red,
										top_i_light = red,
										bottom_o_light = red,
										bottom_i_light = red,
										emergency = true
					)
			)
		


		+ 	(emergency == true) -> (
				emergencyOver(i).Lock(emergency = false)
				+ (paddle_status == closing) -> paddle(i, closed).Lock(paddle_status = closed)
				+ (culvert_status == closing) -> culvert(i, closed).Lock(culvert_status = closed)
		)
		
		+ 	(boat_present == empty) -> (

				sendAvailable(i, downBoat).Lock(boat_present = downBoat, boat_location = waiting)
				+ sendAvailable(i, upBoat).Lock(boat_present = upBoat, boat_location = waiting)

						
				+ (bottom_i_light == green) -> light_BI(i,red).Lock(bottom_i_light = red)				% Turn inner bottom light red
				+ (top_i_light == green) -> light_TI(i,red).Lock(top_i_light = red)						% Turn inner top light red
			)


		+ (emergency != true) -> (
			(boat_present == downBoat) ->	(

				(boat_location == waiting) -> (
				  	(bottom_i_light == green) 
					-> light_BI(i,red).Lock(bottom_i_light = red)								% Turn inner bottom light red if necessary
				+ 	(top_i_light == green) 
					-> light_TI(i,red).Lock(top_i_light = red)									% Turn inner top light red if necessary	 
				+ 	(bottom_o_light == green) 
					-> light_BO(i, red).Lock(bottom_o_light = red)								% Turn bottom outside light red 
				+ 	(bottom_o_light == red && bottom_i_light == red && (bottom_g_status == opened || bottom_g_status == stopped))
					-> bottomGate(i, closing).Lock(bottom_g_status = closing)					% Bottom gate starts closing
				+ 	(bottom_g_status == closing)
					-> bottomGate(i,closed).Lock(bottom_g_status = closed)						% Bottom gate is closed
				+ 	(bottom_g_status == closed && culvert_status == closed && w_level != top)
					-> culvert(i,opening).Lock(culvert_status = opening, w_level = between)		% Culvert starts opening
				+ 	(culvert_status == opening)
					-> culvert(i,opened).Lock(culvert_status = opened)							% Culvert is opened
				+ 	(w_level == between && culvert_status == opened)
					-> detectWater(i, top).Lock(w_level = top)									% Water is at top level
				+ 	(w_level == top && culvert_status == opened)
					-> culvert(i,closing).Lock(culvert_status = closing)						% Culvert starts closing
				+ 	(w_level == top && culvert_status == closing)
					-> culvert(i, closed).Lock(culvert_status = closed)							% Culvert is closed
				+ 	(w_level == top && culvert_status == closed && (top_g_status == closed || top_g_status == stopped))
					-> topGate(i, opening).Lock(top_g_status = opening)							% Top gate starts opening
				+ 	(top_g_status == opening) 
					-> topGate(i, opened).Lock(top_g_status = opened)							% Top gate is open
				+ 	(top_g_status == opened && top_i_light == red && top_o_light == red) 
					-> light_TO(i,green).Lock(top_o_light = green)								% Top outside light set to green
				+	(top_g_status == opened && top_o_light == green)  
					-> receiveDownBoat(i, entering).Lock(boat_location = entering)				% Boat can entering				
				)		

			+	(boat_location == entering) -> (
						(top_o_light == green) 
						-> receiveDownBoat(i, inLock).Lock(boat_location = inLock)
					+ 	(top_o_light == red && top_i_light == red && top_g_status == opened) 
						-> light_TO(i,green).Lock(top_o_light = green)
				)

			+	(boat_location == inLock) -> (
					(top_o_light == green) 
					-> light_TO(i, red).Lock(top_o_light = red)									% Turn top outside light red
				+ 	(top_o_light == red && (top_g_status == opened || top_g_status == stopped))
					-> topGate(i, closing).Lock(top_g_status = closing)							% Top gate starts closing
				+  	(top_g_status == closing)
					-> topGate(i, closed).Lock(top_g_status = closed)							% Top gate is closed
				+	(top_g_status == closed && paddle_status == closed && w_level != bottom)
					-> paddle(i, opening).Lock(paddle_status = opening, w_level = between) 		% Paddle starts opening
				+ 	(paddle_status == opening)
					-> paddle(i, opened).Lock(paddle_status = opened)							% Paddle fully opened
				+ 	(paddle_status == opened && w_level == between)
					-> detectWater(i, bottom).Lock(w_level = bottom)							% Water is at bottom level
				+ 	(w_level == bottom && paddle_status == opened)
					-> paddle(i, closing).Lock(paddle_status = closing)							% Paddle starts closing
				+ 	(w_level == bottom && paddle_status == closing)
					-> paddle(i, closed).Lock(paddle_status = closed)							% Paddle fully closed
				+ 	(w_level == bottom && paddle_status == closed && (bottom_g_status == closed || bottom_g_status == stopped)) 
					-> bottomGate(i, opening).Lock(bottom_g_status = opening)					% Bottom gate starts opening
				+ 	(bottom_g_status == opening)
					-> bottomGate(i, opened).Lock(bottom_g_status = opened)						% Bottom gate is open
				+ 	(bottom_g_status == opened && bottom_i_light == red && bottom_o_light == red)
					-> light_BI(i, green).Lock(bottom_i_light = green)							% Bottom inside light set to green
				+ 	(bottom_i_light == green)
					-> receiveDownBoat(i, exiting).Lock(boat_location = exiting)				% Boat can start exiting
				)
			+ 	(boat_location == exiting) -> (
					(bottom_i_light == green) ->
						receiveDownBoat(i, none).Lock(boat_present = empty, boat_location = none)
					+ (bottom_i_light == red && bottom_i_light == red && bottom_g_status == opened) ->
						light_BI(i, green).Lock(bottom_i_light = green)
				)			
			)

		+ 	(boat_present == upBoat) ->	(

				(boat_location == waiting) -> (
					(bottom_i_light == green) 
					-> light_BI(i,red).Lock(bottom_i_light = red)								% Turn bottom inside light red if necessary
				+	(top_i_light == green) 
					-> light_TI(i,red).Lock(top_i_light = red)									% Turn top inside light red if necessary
				+ 	(top_o_light == green) 
					-> light_TO(i, red).Lock(top_o_light = red)									% Turn top outside light red
				+ 	(top_o_light == red && top_i_light == red && (top_g_status == opened || top_g_status == stopped))
					-> topGate(i, closing).Lock(top_g_status = closing)							% Top gate starts closing
				+  	(top_g_status == closing)
					-> topGate(i, closed).Lock(top_g_status = closed)							% Top gate is closed
				+	(top_g_status == closed && (paddle_status == closed || paddle_status == closing) && w_level != bottom)
					-> paddle(i, opening).Lock(paddle_status = opening, w_level = between) 		% Paddle starts opening
				+ 	(paddle_status == opening)
					-> paddle(i, opened).Lock(paddle_status = opened)							% Paddle fully opened
				+ 	(paddle_status == opened && w_level == between)
					-> detectWater(i, bottom).Lock(w_level = bottom)							% Water is at bottom level
				+ 	(w_level == bottom && paddle_status == opened)
					-> paddle(i, closing).Lock(paddle_status = closing)							% Paddle starts closing
				+ 	(w_level == bottom && paddle_status == closing)
					-> paddle(i, closed).Lock(paddle_status = closed)							% Paddle fully closed
				+ 	(w_level == bottom && paddle_status == closed && (bottom_g_status == closed || bottom_g_status == stopped)) 
					-> bottomGate(i, opening).Lock(bottom_g_status = opening)					% Bottom gate starts opening
				+ 	(bottom_g_status == opening)
					-> bottomGate(i, opened).Lock(bottom_g_status = opened)						% Bottom gate is open
				+	(bottom_g_status == opened && bottom_i_light == red && bottom_o_light == red)
					-> light_BO(i,green).Lock(bottom_o_light = green)							% Bottom outside light set to green 
				+	(bottom_g_status == opened && bottom_o_light == green) 
					-> receiveUpBoat(i, entering).Lock(boat_location = entering)				% Boat can start entering
				)	

			+ 	(boat_location == entering) -> (
						(bottom_o_light == green) 
						-> receiveUpBoat(i, inLock).Lock(boat_location = inLock)
					+ 	(bottom_o_light == red && bottom_i_light == red && bottom_g_status == opened)
						-> light_BO(i,green).Lock(bottom_o_light = green)

				)

			+	(boat_location == inLock) -> (
					(bottom_o_light == green) -> 
						light_BO(i, red).Lock(bottom_o_light = red)								% Turn bottom outside light red
					+ (bottom_o_light == red && (bottom_g_status == opened || bottom_g_status == stopped))
						-> bottomGate(i, closing).Lock(bottom_g_status = closing)				% Bottom gate starts closing
					+ (bottom_g_status == closing)
						-> bottomGate(i,closed).Lock(bottom_g_status = closed)					% Bottom gate is closed
					+ (bottom_g_status == closed && (culvert_status == closed || culvert_status == closing) && w_level != top)	
						-> culvert(i,opening).Lock(culvert_status = opening, w_level = between)	% Culvert starts opening
					+ (culvert_status == opening)
						-> culvert(i,opened).Lock(culvert_status = opened)						% Culvert fully opened
					+ (w_level == between && culvert_status == opened)
						-> detectWater(i, top).Lock(w_level = top)								% Water is at top level
					+ (w_level == top && culvert_status == opened)
						-> culvert(i,closing).Lock(culvert_status = closing)					% Culvert starts closing
					+ (w_level == top && culvert_status == closing)
						-> culvert(i, closed).Lock(culvert_status = closed)						% Culvert is closed
					+ (w_level == top && culvert_status == closed && (top_g_status == closed || top_g_status == stopped))
						-> topGate(i, opening).Lock(top_g_status = opening)						% Top gate starts opening
					+ (top_g_status == opening) 
						-> topGate(i, opened).Lock(top_g_status = opened)						% Top gate is open
					+ (top_g_status == opened && top_o_light == red && top_i_light == red)
						-> light_TI(i, green).Lock(top_i_light = green)							% Top outside light set to green
					+ (top_i_light == green)
						-> receiveUpBoat(i, exiting).Lock(boat_location= exiting)				% Boat can start exiting
				
			)
			+ 	(boat_location == exiting) -> (
					(top_i_light == green) -> 
						receiveUpBoat(i, none).Lock(boat_present = empty, boat_location = none)
					+ (top_i_light == red && top_o_light == red && top_g_status == opened) ->
						light_TI(i, green).Lock(top_i_light = green)
				)
		)
		)	
;


proc BoatController(top_waiting: Int, bottom_waiting: Int, l1_boat: BoatLocation, l2_boat: BoatLocation) = 
	
	(top_waiting <= 0)
		-> arriveTop.BoatController(top_waiting = top_waiting + 1) 				% downBoat arrives
	+ (bottom_waiting <= 0)
		-> arriveBottom.BoatController(bottom_waiting = bottom_waiting + 1) 	% upBoat arrives
	+ 	(top_waiting > 0) -> (
			receiveAvailable(l1, downBoat).BoatController(top_waiting = top_waiting - 1, l1_boat = waiting)				
		+ 	receiveAvailable(l2, downBoat).BoatController(top_waiting = top_waiting - 1, l2_boat = waiting)
		)
	+	(bottom_waiting > 0) -> (
			receiveAvailable(l1, upBoat).BoatController(bottom_waiting = bottom_waiting - 1, l1_boat = waiting)
	 	+ 	receiveAvailable(l2, upBoat).BoatController(bottom_waiting = bottom_waiting - 1, l2_boat = waiting)
		)
	+ 	(l1_boat == waiting) -> (
			sendDownBoat(l1, entering).BoatController(l1_boat = entering) 
		+ 	sendUpBoat(l1, entering).BoatController(l1_boat = entering)
		)
	+ 	(l2_boat == waiting) -> ( 
			sendDownBoat(l2, entering).BoatController(l2_boat = entering) 
		+ 	sendUpBoat(l2, entering).BoatController(l2_boat = entering)
		)
	+ 	(l1_boat == entering) -> (
			sendDownBoat(l1, inLock).BoatController(l1_boat = inLock)
		+ 	sendUpBoat(l1, inLock).BoatController(l1_boat = inLock)
		)
	+ 	(l2_boat == entering) -> (
			sendDownBoat(l2, inLock).BoatController(l2_boat = inLock) 
		+ 	sendUpBoat(l2, inLock).BoatController(l2_boat = inLock)
		)
	+ 	(l1_boat == inLock) -> (
			sendDownBoat(l1, exiting).BoatController(l1_boat = exiting) 
		+ 	sendUpBoat(l1, exiting).BoatController(l1_boat = exiting)
		)
	+ 	(l2_boat == inLock) -> (
			sendDownBoat(l2, exiting).BoatController(l2_boat = exiting) 
		+ 	sendUpBoat(l2, exiting).BoatController(l2_boat = exiting)
		)
	+ 	(l1_boat == exiting) -> (
			sendDownBoat(l1, none).BoatController(l1_boat = none) 
		+ 	sendUpBoat(l1, none).BoatController(l1_boat = none)
		)
	+ 	(l2_boat == exiting) -> (
			sendDownBoat(l2, none).BoatController(l2_boat = none) 
		+ 	sendUpBoat(l2, none).BoatController(l2_boat = none)
		)
;



init allow( {	% Non-Communicating
				light_TO, light_TI, light_BO, light_BI,
			 	topGate, bottomGate, culvert, paddle,
				arriveBottom, arriveTop,
				detectWater,
				emergency, emergencyOver, 
				% Communicating
				assignLock, downBoat, upBoat
			
			},
	 comm( {	sendAvailable 	|	receiveAvailable 	-> assignLock,
				sendDownBoat	|	receiveDownBoat		-> downBoat,
				sendUpBoat		| 	receiveUpBoat		-> upBoat

			}, Lock(l1, bottom, closed, opened, red, red, green, red, closed, closed, empty, none, false)||Lock(l2, bottom, closed, opened, red, red, green, red, closed, closed, empty, none, false)||BoatController(0,0, none, none)));